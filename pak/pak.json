{
  "id": "org.umrk.sshserver",
  "name": "SSH Server",
  "icon": "res/icon.png",
  "platform": "mlp1",
  "pak_version": "0.1.0",
  "min_jawaka_version": "0.0.1",
  "service": {
    "schema": 1,
    "id": "org.umrk.sshserver",
    "run": {
      "path": "launch.sh",
      "args": ["service", "run"]
    },
    "restart": "on-failure",
    "default_enabled": false,
    "stop_grace_ms": 3000,
    "lifecycle": {
      "game": "ignore",
      "stop_on_storage_change": true,
      "stop_on_suspend": false
    }
  },
  "state": {
    "root": "umrk-ssh-server",
    "revoke_on_uninstall": ["config.ini", "authorized_keys"],
    "retained_roots": ["hostkeys", "logs"]
  }
}
