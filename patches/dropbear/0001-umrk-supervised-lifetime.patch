--- a/src/dbutil.c
+++ b/src/dbutil.c
@@ -85,0 +86,27 @@
+static pid_t umrk_expected_parent = -1;
+
+int umrk_service_managed(void) {
+	const char *lease = getenv("UMRK_SERVICE_LEASE_FD");
+	return lease && strcmp(lease, "3") == 0 && fcntl(3, F_GETFD) >= 0;
+}
+
+void umrk_service_arm_child(pid_t expected_parent) {
+	if (!umrk_service_managed()) {
+		return;
+	}
+	umrk_expected_parent = expected_parent;
+#if defined(__linux__) && defined(PR_SET_PDEATHSIG)
+	if (prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 || getppid() != expected_parent) {
+		_exit(127);
+	}
+#else
+	(void)expected_parent;
+#endif
+}
+
+void umrk_service_rearm_child(void) {
+	if (umrk_expected_parent > 0) {
+		umrk_service_arm_child(umrk_expected_parent);
+	}
+}
+
