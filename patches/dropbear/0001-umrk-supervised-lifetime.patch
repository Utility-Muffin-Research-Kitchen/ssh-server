+
+int umrk_service_managed(void) {
+	const char *lease = getenv("UMRK_SERVICE_LEASE_FD");
+	return lease && strcmp(lease, "3") == 0 && fcntl(3, F_GETFD) >= 0;
+}
+
+void umrk_service_arm_child(pid_t expected_parent) {
+	umrk_connection_guardian = 0;
+	if (!umrk_service_managed()) {
+		return;
+	}
+	umrk_expected_parent = expected_parent;
+#if defined(__linux__) && defined(PR_SET_PDEATHSIG)
+	if (prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 || getppid() != expected_parent) {
+		_exit(127);
+	}
+#else
+	(void)expected_parent;
+#endif
+}
+
+void umrk_service_arm_guardian(pid_t expected_parent) {
+	if (!umrk_service_managed()) {
+		return;
+	}
+	umrk_expected_parent = expected_parent;
+#if defined(__linux__) && defined(PR_SET_PDEATHSIG) && defined(PR_SET_CHILD_SUBREAPER)
+	if (prctl(PR_SET_CHILD_SUBREAPER, 1) != 0 ||
+			prctl(PR_SET_PDEATHSIG, SIGTERM) != 0 ||
+			getppid() != expected_parent) {
+		_exit(127);
+	}
+	umrk_connection_guardian = 1;
+#else
+	(void)expected_parent;
+#endif
+}
+
+void umrk_service_rearm_child(void) {
+	if (umrk_expected_parent <= 0 || fcntl(3, F_GETFD) < 0) {
+		return;
+	}
+#if defined(__linux__) && defined(PR_SET_PDEATHSIG)
+	if (prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 ||
+			getppid() != umrk_expected_parent) {
+		_exit(127);
+	}
+#endif
+}
+
+void umrk_service_cleanup_descendants(void) {
+#if defined(__linux__)
+	int kill_sent = 0;
+	if (!umrk_connection_guardian || !umrk_service_managed()) {
+		return;
+	}
+	for (;;) {
+		char children_path[96];
+		pid_t children[256];
+		size_t count = 0;
+		long raw_pid = 0;
+		int status = 0;
+		FILE *children_file;
+
+		while (waitpid(-1, &status, WNOHANG) > 0) {
+			/* reap children already made absent */
+		}
+		snprintf(children_path, sizeof(children_path),
+				"/proc/self/task/%ld/children", (long)getpid());
+		children_file = fopen(children_path, "r");
+		if (!children_file) {
+			/* Fail safe: retain descriptor 3 and the guardian process rather
+			 * than release the generation without descendant evidence. */
+			usleep(50000);
+			continue;
+		}
+		while (count < sizeof(children) / sizeof(children[0]) &&
+				fscanf(children_file, "%ld", &raw_pid) == 1) {
+			if (raw_pid > 0 && raw_pid <= INT_MAX) {
+				children[count++] = (pid_t)raw_pid;
+			}
+		}
+		fclose(children_file);
+		if (count == 0) {
+			break;
+		}
+		for (size_t i = 0; i < count; i++) {
+			(void)kill(children[i], kill_sent ? SIGKILL : SIGTERM);
+		}
+		kill_sent = 1;
+		usleep(50000);
+	}
+	unsetenv("UMRK_SERVICE_LEASE_FD");
+	m_close(3);
 #endif
+}
 
